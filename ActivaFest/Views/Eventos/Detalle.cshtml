@model Evento
@inject Microsoft.Extensions.Options.IOptions<ActivaFest.Services.Compras.ComprasOptions> OpcionesCompras
@{
    ViewData["Title"] = Model.Titulo;
    var imagenes = Model.Imagenes.OrderBy(i => i.Orden).ToList();
    var tipos = Model.TiposEntrada.OrderBy(t => t.Precio).ToList();
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    // Un evento realizado o cancelado ya no tiene aforo "disponible"
    var mostrarDisponibles = !Model.YaOcurrio(DateTime.Now) && Model.Estado != EstadoEvento.Cancelado;
}

@section Styles {
    <partial name="_LeafletCss" />
    <link rel="stylesheet" href="~/css/plano.css" asp-append-version="true" />
}

<!-- El asistente virtual usa este evento como contexto ("¿dónde es?", "¿cuánto cuesta?") -->
<div id="chat-contexto" data-evento="@Model.Id" hidden></div>

<a asp-action="Index" class="enlace-volver">← Volver al catálogo</a>

<div class="ficha">
    <!-- 📸 GALERÍA (HU03) -->
    <section class="ficha-galeria">
        @if (imagenes.Count > 0)
        {
            <div id="galeriaEvento" class="carousel slide" data-bs-ride="carousel">
                @if (imagenes.Count > 1)
                {
                    <div class="carousel-indicators">
                        @for (var i = 0; i < imagenes.Count; i++)
                        {
                            <button type="button" data-bs-target="#galeriaEvento" data-bs-slide-to="@i"
                                    class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : null)"
                                    aria-label="Foto @(i + 1)"></button>
                        }
                    </div>
                }
                <div class="carousel-inner">
                    @for (var i = 0; i < imagenes.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@imagenes[i].Ruta" class="d-block w-100" alt="Foto @(i + 1) de @Model.Titulo"
                                 loading="@(i == 0 ? "eager" : "lazy")" />
                        </div>
                    }
                </div>
                @if (imagenes.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#galeriaEvento" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Anterior</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#galeriaEvento" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Siguiente</span>
                    </button>
                }
            </div>
        }
        else
        {
            <div class="sin-imagen sin-imagen-grande">@Model.Categoria?.Icono</div>
        }
    </section>

    <!-- ℹ️ INFORMACIÓN -->
    <section class="ficha-info">
        @if (ViewBag.PuedeEditar == true && !Model.YaOcurrio(DateTime.Now) && Model.Estado != EstadoEvento.Cancelado)
        {
            <p class="acciones-evento">
                <a asp-action="Editar" asp-route-id="@Model.Id" class="btn-gris enlace-boton">✏️ Editar evento</a>
                @if (Model.Estado == EstadoEvento.Aprobado)
                {
                    <a asp-controller="Panel" asp-action="Evento" asp-route-id="@Model.Id" class="btn-gris enlace-boton">📊 Panel de ventas</a>
                }
            </p>
        }
        @if (Model.Estado != EstadoEvento.Aprobado)
        {
            <p><span class="badge-estado badge-@Model.Estado">@Model.Estado</span></p>
            @if (Model.Estado == EstadoEvento.Cancelado)
            {
                <p class="aviso-vencido">🚫 Este evento fue cancelado. Motivo: @Model.MotivoCancelacion. Las entradas quedaron anuladas y el organizador gestionará la devolución.</p>
            }
        }
        @if (Model.YaOcurrio(DateTime.Now))
        {
            <p class="aviso-vencido">Este evento ya se realizó.</p>
        }

        <span class="card-categoria estatica">@Model.Categoria?.Icono @Model.Categoria?.Nombre</span>
        <h2 class="text-gradient">@Model.Titulo</h2>

        <ul class="ficha-datos">
            <li>📅 @Formato.Fecha(Model.Fecha, "dddd dd 'de' MMMM 'de' yyyy")</li>
            <li>🕗 @Model.Fecha.ToString("HH:mm") horas</li>
            <li>📍 @Model.Ubicacion</li>
            @if (Model.Aforo > 0)
            {
                // HU03: aforo disponible = capacidad menos lo vendido y lo reservado en compras en curso
                var disponibles = tipos.Sum(t => t.Disponibles);
                <li>
                    👥 Aforo: @Model.Aforo.ToString("N0") personas
                    @if (mostrarDisponibles)
                    {
                        <span class="aforo-disponible @(disponibles == 0 ? "agotado" : "")">
                            · @(disponibles == 0 ? "agotado" : $"{disponibles:N0} disponibles")
                        </span>
                    }
                </li>
            }
        </ul>

        <!-- 💲 PRECIOS -->
        <div class="ficha-precios">
            <h3>Entradas</h3>
            @if (tipos.Count == 0)
            {
                <p class="texto-suave">El organizador aún no publicó los precios.</p>
            }
            else
            {
                var enVenta = Model.Estado == EstadoEvento.Aprobado && Model.Fecha > DateTime.Now;
                var agotado = tipos.All(t => t.Disponibles == 0);
                // HU26: en teatro se eligen los asientos exactos en el plano; en el resto, zona y cantidad
                var conAsientos = tipos.Any(t => t.AsientosNumerados);

                <!-- 🛒 SELECCIÓN DE ENTRADAS (HU06) -->
                <form asp-controller="Compras" asp-action="Iniciar" method="post" id="comprar" class="form-compra">
                    <input type="hidden" name="eventoId" value="@Model.Id" />
                    <table>
                        <thead>
                            <tr>
                                <th>Zona</th><th>Precio</th>
                                @if (mostrarDisponibles) { <th class="col-disponibles">Disponibles</th> }
                                @if (enVenta) { <th class="col-cantidad">@(conAsientos ? "Elegidos" : "Cantidad")</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in tipos)
                            {
                                <tr>
                                    <td>@t.Nombre</td>
                                    <td class="precio">@Formato.Precio(t.Precio)</td>
                                    @if (mostrarDisponibles)
                                    {
                                        <td class="col-disponibles">
                                            @if (t.Disponibles == 0)
                                            {
                                                <span class="agotado">Agotado</span>
                                            }
                                            else if (t.Disponibles <= 10)
                                            {
                                                <span class="quedan">¡Quedan @t.Disponibles!</span>
                                            }
                                            else
                                            {
                                                @t.Disponibles.ToString("N0")
                                            }
                                        </td>
                                    }
                                    @if (enVenta)
                                    {
                                        <td class="col-cantidad">
                                            @if (t.Disponibles == 0)
                                            {
                                                <span class="agotado">Agotado</span>
                                            }
                                            else if (conAsientos)
                                            {
                                                <span class="contador-zona" data-zona="@t.Id" data-precio="@t.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)">0</span>
                                            }
                                            else
                                            {
                                                <select name="cantidades[@t.Id]" class="selector-cantidad"
                                                        data-precio="@t.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                        aria-label="Cantidad de entradas @t.Nombre">
                                                    @for (var n = 0; n <= Math.Min(10, t.Disponibles); n++)
                                                    {
                                                        <option value="@n">@n</option>
                                                    }
                                                </select>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (!enVenta)
                    {
                        <p class="texto-suave aviso-venta">La venta de entradas para este evento no está disponible.</p>
                    }
                    else if (agotado)
                    {
                        <p class="agotado aviso-venta">😔 Entradas agotadas</p>
                    }
                    else if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@($"/Eventos/Detalle/{Model.Id}#comprar")"
                           class="btn-rosa btn-bloque enlace-boton">🎟️ Inicia sesión para comprar</a>
                    }
                    else
                    {
                        @if (conAsientos)
                        {
                            <div class="asientos-elegidos" id="asientosElegidos" data-max="@OpcionesCompras.Value.MaxEntradasPorOrden" aria-live="polite">
                                <p class="texto-suave">👇 Elige tus asientos en el <a href="#plano">plano del recinto</a> (máx. @OpcionesCompras.Value.MaxEntradasPorOrden).</p>
                                <ul id="listaAsientos"></ul>
                            </div>
                            <div id="inputsAsientos"></div>
                        }
                        <p class="total-compra">Total: <b id="totalCompra">S/ 0.00</b></p>
                        <button type="submit" class="btn-rosa btn-bloque" id="btnComprar" disabled>🎟️ Comprar entradas</button>
                        <p class="texto-suave nota-reserva">Reservamos tus entradas por @OpcionesCompras.Value.MinutosReserva minutos mientras pagas.</p>
                    }
                </form>
            }
        </div>
    </section>
</div>

<!-- 🗺️ PLANO DEL RECINTO (HU25) -->
@if (tipos.Count > 0)
{
    var zonasPlano = Model.TiposEntrada.OrderBy(t => t.Id).ToList();
    // HU26: el plano es interactivo cuando se puede comprar (clic en asientos o en zonas)
    var planoInteractivo = Model.Estado == EstadoEvento.Aprobado && Model.Fecha > DateTime.Now && User.Identity?.IsAuthenticated == true;
    <section class="ficha-seccion plano-recinto" id="plano">
        <h3>Plano del recinto</h3>
        <p class="texto-suave">
            Plantilla: @ActivaFest.Services.Plano.PlanoService.Nombre(Model.PlantillaPlano).ToLowerInvariant()@(Model.PlantillaPlano == PlantillaPlano.Teatro ? " con asientos numerados" : "").
        </p>
        @if (planoInteractivo)
        {
            <p class="texto-suave">@(Model.PlantillaPlano == PlantillaPlano.Teatro ? "Toca los asientos libres para elegirlos; los grises ya no están disponibles." : "Toca una zona para elegir cuántas entradas quieres.")</p>
        }
        <div class="plano-lienzo @(planoInteractivo ? "plano-interactivo" : "")">@Html.Raw((string)ViewBag.PlanoSvg)</div>
        <ul class="plano-leyenda">
            @for (var i = 0; i < zonasPlano.Count; i++)
            {
                var z = zonasPlano[i];
                <li>
                    <span class="plano-punto" style="background: @ActivaFest.Services.Plano.PlanoService.ColorValido(z.Color, i)"></span>
                    @z.Nombre · @(z.Precio == 0 ? "Gratis" : Formato.Precio(z.Precio))
                    @if (z.AsientosNumerados)
                    {
                        <span class="texto-suave">(@z.Filas filas × @z.AsientosPorFila asientos)</span>
                    }
                    @if (!string.IsNullOrEmpty(z.PuertaIngreso))
                    {
                        <span class="texto-suave">· 🚪 @z.PuertaIngreso</span>
                    }
                </li>
            }
        </ul>
    </section>
}

@if (!string.IsNullOrWhiteSpace(Model.Descripcion))
{
    <section class="ficha-seccion">
        <h3>Acerca del evento</h3>
        <p class="descripcion">@Model.Descripcion</p>
    </section>
}

<!-- 🗺️ MAPA Y RUTA (HU04) -->
<section class="ficha-seccion">
    <h3>Cómo llegar</h3>

    @if (Model.TieneUbicacion)
    {
        <div class="ruta-acciones">
            <button type="button" id="btnRuta" class="btn-rosa">🧭 Trazar ruta desde mi ubicación</button>
            <a class="btn-gris enlace-boton" target="_blank" rel="noopener"
               href="https://www.google.com/maps/dir/?api=1&destination=@Model.Latitud!.Value.ToString(inv),@Model.Longitud!.Value.ToString(inv)">
                Abrir en Google Maps ↗
            </a>
        </div>
        <p id="rutaInfo" class="ruta-info" role="status" aria-live="polite"></p>

        <div id="mapaEvento" class="mapa"
             data-lat="@Model.Latitud!.Value.ToString(inv)"
             data-lng="@Model.Longitud!.Value.ToString(inv)"
             data-titulo="@Model.Titulo"
             data-direccion="@Model.Ubicacion"></div>
    }
    else
    {
        <p class="texto-suave">📍 @Model.Ubicacion — el organizador aún no marcó la ubicación exacta en el mapa.</p>
    }
</section>

@section Scripts {
    <script src="~/js/compra.js" asp-append-version="true"></script>
    <script src="~/js/plano-compra.js" asp-append-version="true"></script>
    @if (Model.TieneUbicacion)
    {
        <partial name="_LeafletJs" />
        <script src="~/js/mapa-evento.js" asp-append-version="true"></script>
    }
}
