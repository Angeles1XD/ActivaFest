@model ActivaFest.Models.Evento

@{
    ViewData["Title"] = "Crear evento";
}

<h2 class="text-gradient">Crear Evento</h2>
<p class="texto-suave">El evento quedará pendiente hasta que un administrador lo apruebe.</p>

<form asp-action="Crear" method="post">

    <!-- Validación general -->
    <div asp-validation-summary="All" class="text-danger"></div>

    <!-- Título -->
    <div class="mb-3">
        <label asp-for="Titulo" class="form-label"></label>
        <input asp-for="Titulo" class="form-control" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>

    <!-- Categoría -->
    <div class="mb-3">
        <label asp-for="Categoria" class="form-label"></label>
        <input asp-for="Categoria" class="form-control" />
        <span asp-validation-for="Categoria" class="text-danger"></span>
    </div>

    <!-- Ubicación -->
    <div class="mb-3">
        <label asp-for="Ubicacion" class="form-label"></label>
        <input asp-for="Ubicacion" class="form-control" />
        <span asp-validation-for="Ubicacion" class="text-danger"></span>
    </div>

    <!-- Fecha -->
    <div class="mb-3">
        <label asp-for="Fecha" class="form-label"></label>
        <input asp-for="Fecha" type="datetime-local" class="form-control" />
        <span asp-validation-for="Fecha" class="text-danger"></span>
    </div>

    <!-- Asistentes -->
    <div class="mb-3">
        <label asp-for="Asistentes" class="form-label"></label>
        <input asp-for="Asistentes" type="number" class="form-control" />
        <span asp-validation-for="Asistentes" class="text-danger"></span>
    </div>

    <!-- Botón -->
    <button type="submit" class="btn btn-primary">Guardar</button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}