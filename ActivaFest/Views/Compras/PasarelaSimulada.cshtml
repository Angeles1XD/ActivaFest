@model Orden
@{
    ViewData["Title"] = "Pasarela de prueba";
}

@section Styles {
    <partial name="_EstilosCompra" />
}

<div class="pagina-categorias pagina-compra">
    <ol class="pasos" aria-label="Pasos de la compra">
        <li class="hecho">Entradas</li>
        <li class="hecho">Confirmar</li>
        <li class="actual" aria-current="step">Pago</li>
        <li>¡Listo!</li>
    </ol>

    <div class="tarjeta-compra pasarela-simulada">
        <p class="sello-prueba">🧪 PASARELA DE PRUEBA</p>
        <h1>Pago simulado</h1>
        <p class="texto-pasarela">
            Esta pantalla reemplaza a la pasarela real mientras no haya credenciales de Mercado Pago configuradas.
            No se pide ni se guarda ningún dato de tarjeta.
        </p>

        <div class="monto-grande">@Formato.Precio(Model.Total)</div>
        <p class="texto-pasarela">@Model.Evento?.Titulo · @Model.CantidadEntradas @(Model.CantidadEntradas == 1 ? "entrada" : "entradas")</p>

        <div class="acciones-pasarela">
            <form asp-action="PasarelaSimulada" asp-route-codigo="@Model.Codigo" method="post">
                <input type="hidden" name="aprobar" value="true" />
                <button type="submit" class="cat-boton boton-ancho">✅ Aprobar pago</button>
            </form>
            <form asp-action="PasarelaSimulada" asp-route-codigo="@Model.Codigo" method="post">
                <input type="hidden" name="aprobar" value="false" />
                <button type="submit" class="boton-secundario boton-ancho">❌ Simular pago rechazado</button>
            </form>
        </div>
    </div>
</div>
