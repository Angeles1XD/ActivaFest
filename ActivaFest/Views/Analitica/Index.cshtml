@model ActivaFest.Services.Analitica.DashboardAnalitica
@using System.Text.Json
@using ActivaFest.Services.Analitica
@{
    ViewData["Title"] = "Dashboard de la plataforma";
    var categorias = (List<Categoria>)ViewBag.Categorias;
    var rango = (string)ViewBag.Rango;
    var nombreRango = FiltroAnalitica.Rangos.First(r => r.Clave == rango).Nombre;
    var desde = Model.Desde.ToString("yyyy-MM-dd");
    var hasta = Model.Hasta.ToString("yyyy-MM-dd");
    var dias = (Model.Hasta - Model.Desde).Days + 1;
    var categoria = categorias.FirstOrDefault(c => c.Id == Model.CategoriaId);

    string Pct(double? v) => v == null ? "—" : $"{v.Value:0.#} %";
    string F(DateTime d) => d.ToString("dd/MM/yyyy");

    // Variación frente al período anterior: subida en verde, bajada en rojo (con flecha, no solo color)
    string Variacion(decimal actual, decimal anterior)
    {
        var v = DashboardAnalitica.Variacion(actual, anterior);
        return v == null ? "sin ventas en el período anterior" : $"{(v >= 0 ? "▲ +" : "▼ ")}{v:0.#} % vs. período anterior";
    }
    string Clase(decimal actual, decimal anterior) => DashboardAnalitica.Variacion(actual, anterior) switch { null => "", >= 0 => "sube", _ => "baja" };

    // Datos iniciales de los gráficos (Chart.js); luego se actualizan solos desde /Analitica/Datos
    var datosGraficos = JsonSerializer.Serialize(new
    {
        semanas = Model.IngresosPorSemana.Select(s => new { etiqueta = s.Etiqueta, ingresos = s.Ingresos }),
        categorias = Model.VentasPorCategoria.Select(c => new { nombre = c.Categoria, entradas = c.Entradas, ingresos = c.Ingresos, color = c.Color })
    });
}

@section Styles {
    <partial name="_EstilosCompra" />
    <link rel="stylesheet" href="~/css/organizador.css" asp-append-version="true" />
}

<div class="pagina-categorias pagina-panel viz-root" id="dashboard"
     data-url="@Url.Action("Datos", "Analitica", new { rango, desde = rango == "personalizado" ? desde : null, hasta = rango == "personalizado" ? hasta : null, categoriaId = Model.CategoriaId })">
    <header class="cat-encabezado catalogo-encabezado">
        <div>
            <p class="cat-migas">Activa-Fest / Administración / Analítica</p>
            <h1>Dashboard de la <span class="degradado">plataforma</span></h1>
            <p class="cat-subtitulo">
                <span class="en-vivo" aria-hidden="true"></span>
                En vivo: se actualiza solo cada 20 segundos · <span id="actualizado" data-calculado="@Model.CalculadoEn.ToString("o")">actualizado ahora</span>
            </p>
        </div>
        <div class="panel-acciones">
            <a asp-action="Variabilidad" class="btn-gris enlace-boton">📈 Variabilidad</a>
            <a asp-action="Asistente" class="btn-gris enlace-boton">💬 Asistente</a>
            <a asp-action="Clientes" class="btn-gris enlace-boton">👥 Clientes</a>
            <a asp-controller="Admin" asp-action="Index" class="btn-gris enlace-boton">← Moderación</a>
        </div>
    </header>

    <!-- Filtros: período (por fecha de pago de las compras) y categoría -->
    <form method="get" class="filtros filtros-reporte filtros-dashboard" id="filtrosDashboard">
        <div class="filtro">
            <label for="rango">Período</label>
            <select id="rango" name="rango">
                @foreach (var r in FiltroAnalitica.Rangos)
                {
                    <option value="@r.Clave" selected="@(r.Clave == rango)">@r.Nombre</option>
                }
            </select>
        </div>
        <div class="filtro filtro-fecha">
            <label for="desde">Desde</label>
            <input id="desde" name="desde" type="date" value="@desde" />
        </div>
        <div class="filtro filtro-fecha">
            <label for="hasta">Hasta</label>
            <input id="hasta" name="hasta" type="date" value="@hasta" />
        </div>
        <div class="filtro">
            <label for="categoriaId">Categoría</label>
            <select id="categoriaId" name="categoriaId">
                <option value="">Todas las categorías</option>
                @foreach (var c in categorias)
                {
                    <option value="@c.Id" selected="@(Model.CategoriaId == c.Id)">@c.Icono @c.Nombre</option>
                }
            </select>
        </div>
        <div class="filtro-acciones">
            <button type="submit" class="btn-rosa">Aplicar</button>
            <a asp-action="Index" class="btn-gris enlace-boton">Limpiar</a>
            <a asp-action="Exportar" asp-route-rango="@rango" asp-route-desde="@desde" asp-route-hasta="@hasta" asp-route-categoriaId="@Model.CategoriaId" class="btn-gris enlace-boton">⬇ Exportar</a>
        </div>
    </form>

    <p class="resumen-filtro" data-dato="resumen-filtro">
        Mostrando <b>@nombreRango.ToLowerInvariant()</b>: compras pagadas del <b>@F(Model.Desde)</b> al <b>@F(Model.Hasta)</b>
        · <b>@(categoria == null ? "todas las categorías" : $"{categoria.Icono} {categoria.Nombre}")</b>
        · comparado con el período anterior (@F(Model.Desde.AddDays(-dias)) – @F(Model.Desde.AddDays(-1))).
    </p>

    <!-- 📊 Indicadores (HU21) -->
    <section class="fila-kpi fila-kpi-dashboard" aria-label="Indicadores del período">
        <div class="kpi kpi-hero">
            <span class="kpi-etiqueta">Ingresos</span>
            <span class="kpi-valor" data-kpi="ingresos">@Formato.Monto(Model.Ingresos)</span>
            <span class="kpi-nota kpi-variacion @Clase(Model.Ingresos, Model.IngresosAnterior)" data-nota="ingresos">@Variacion(Model.Ingresos, Model.IngresosAnterior)</span>
        </div>
        <div class="kpi">
            <span class="kpi-etiqueta">Entradas vendidas</span>
            <span class="kpi-valor" data-kpi="entradas">@Model.EntradasVendidas.ToString("N0")</span>
            <span class="kpi-nota kpi-variacion @Clase(Model.EntradasVendidas, Model.EntradasAnterior)" data-nota="entradas">@Variacion(Model.EntradasVendidas, Model.EntradasAnterior)</span>
        </div>
        <div class="kpi">
            <span class="kpi-etiqueta">Ticket promedio</span>
            <span class="kpi-valor" data-kpi="ticket">@Formato.Monto(Model.TicketPromedio)</span>
            <span class="kpi-nota" data-nota="ticket">@Model.Compras.ToString("N0") @(Model.Compras == 1 ? "compra" : "compras")</span>
        </div>
        <div class="kpi">
            <span class="kpi-etiqueta">Ocupación</span>
            <span class="kpi-valor" data-kpi="ocupacion">@Pct(Model.Ocupacion)</span>
            <span class="kpi-nota" data-nota="ocupacion">@Model.VendidasEventos.ToString("N0") de @Model.AforoEventos.ToString("N0") lugares · @Model.EventosConsiderados @(Model.EventosConsiderados == 1 ? "evento" : "eventos")</span>
        </div>
        <div class="kpi">
            <span class="kpi-etiqueta">Asistencia</span>
            <span class="kpi-valor" data-kpi="asistencia">@Pct(Model.Asistencia)</span>
            <span class="kpi-nota" data-nota="asistencia">@(Model.EventosRealizados == 0 ? "aún no se realiza ningún evento" : "entradas validadas en puerta")</span>
        </div>
        <div class="kpi">
            <span class="kpi-etiqueta">Comisiones</span>
            <span class="kpi-valor" data-kpi="comisiones">@Formato.Monto(Model.Comisiones)</span>
            <span class="kpi-nota">ingresos de la plataforma</span>
        </div>
        <div class="kpi">
            <span class="kpi-etiqueta">Conversión</span>
            <span class="kpi-valor" data-kpi="conversion">@Pct(Model.Conversion)</span>
            <span class="kpi-nota">compras ÷ visitas a las fichas</span>
        </div>
        <div class="kpi">
            <span class="kpi-etiqueta">Usuarios activos</span>
            <span class="kpi-valor" data-kpi="activos">@Model.UsuariosActivos.ToString("N0")</span>
            <span class="kpi-nota">con compras en los últimos 90 días</span>
        </div>
    </section>
    <details class="nota-reporte como-se-calcula">
        <summary>¿Cómo se calcula cada indicador?</summary>
        <ul>
            <li><b>Ingresos, entradas vendidas, ticket promedio y comisiones:</b> compras pagadas en el período (ticket promedio = ingresos ÷ número de compras).</li>
            <li><b>Ocupación:</b> entradas vendidas ÷ aforo total de los eventos que vendieron en el período o que se realizan en él.</li>
            <li><b>Asistencia:</b> entradas validadas en puerta ÷ entradas vendidas, solo de esos eventos que ya se realizaron.</li>
            <li><b>Conversión:</b> compras ÷ visitas a las fichas de esos eventos.</li>
            <li><b>Usuarios activos:</b> clientes con al menos una compra en los 90 días previos al fin del período.</li>
        </ul>
    </details>

    <div class="graficos-dashboard">
        <section class="tarjeta-panel">
            <h2>Ingresos por semana</h2>
            <p class="texto-tenue">Soles, últimas @AnaliticaService.SemanasTendencia semanas hasta el @F(Model.Hasta)</p>
            <div class="grafico-chart"><canvas id="graficoSemanas" role="img" aria-label="Ingresos por semana"></canvas></div>
        </section>

        <section class="tarjeta-panel">
            <h2>Ventas por categoría</h2>
            <p class="texto-tenue">Entradas vendidas en el período</p>
            <p class="texto-tenue" id="sinVentasCategoria" @(Model.VentasPorCategoria.Count == 0 ? "" : "hidden")>No hay ventas en este período.</p>
            <div class="grafico-chart" id="cajaCategorias" @(Model.VentasPorCategoria.Count == 0 ? "hidden" : "")><canvas id="graficoCategorias" role="img" aria-label="Entradas vendidas por categoría"></canvas></div>
        </section>
    </div>

    <!-- 🧾 Últimas compras: aparecen en cuanto se pagan -->
    <section class="tarjeta-panel ultimas-compras" aria-labelledby="tituloUltimas">
        <h2 id="tituloUltimas">🧾 Últimas compras</h2>
        <p class="texto-tenue">Las 10 compras pagadas más recientes del período. Los clientes se muestran con código anónimo.</p>
        <div class="tabla-contenedor">
            <table class="tabla-datos" id="tablaUltimas">
                <thead><tr><th>Fecha</th><th>Evento</th><th>Cliente</th><th class="derecha">Entradas</th><th class="derecha">Total</th></tr></thead>
                <tbody>
                    @if (Model.UltimasCompras.Count == 0)
                    {
                        <tr><td colspan="5" class="texto-tenue">Aún no hay compras pagadas en este período.</td></tr>
                    }
                    @foreach (var c in Model.UltimasCompras)
                    {
                        <tr>
                            <td class="num">@c.Fecha.ToString("dd/MM HH:mm")</td>
                            <td>@c.Evento</td>
                            <td class="num">Cliente @c.Cliente</td>
                            <td class="derecha num">@c.Entradas</td>
                            <td class="derecha num">@Formato.Monto(c.Total)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- 🤖 Consultas a la IA (HU24): la IA solo lee datos agregados y siempre muestra las cifras fuente -->
    <section class="tarjeta-panel panel-ia" aria-labelledby="tituloIa">
        <h2 id="tituloIa">🤖 Pregúntale a la IA</h2>
        <p class="texto-tenue">Responde con datos reales de la plataforma: cada respuesta muestra la tabla de cifras fuente y el período consultado. Las consultas quedan en la auditoría.</p>
        <div id="iaConversacion" class="ia-conversacion" aria-live="polite"></div>
        <form id="iaFormulario" class="ia-formulario" data-url="@Url.Action("ConsultarIA", "Analitica")">
            @Html.AntiForgeryToken()
            <input type="text" id="iaPregunta" maxlength="300" autocomplete="off" placeholder="Ej.: ¿Cuáles fueron los 5 eventos más vendidos este mes?" aria-label="Pregunta para la IA" />
            <button type="submit" class="btn-rosa">Preguntar</button>
        </form>
        <div class="ia-ejemplos">
            @foreach (var ejemplo in AsistenteAnaliticoService.Ejemplos)
            {
                <button type="button" class="ia-ejemplo">@ejemplo</button>
            }
        </div>
    </section>
</div>

@section Scripts {
    <script type="application/json" id="datosDashboard">@Html.Raw(datosGraficos)</script>
    <partial name="_ChartJs" />
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    <script src="~/js/ia-analitica.js" asp-append-version="true"></script>
}
