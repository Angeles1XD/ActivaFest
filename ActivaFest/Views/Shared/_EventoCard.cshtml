@model EventoCardViewModel

<article class="card-catalogo">
    <a asp-controller="Eventos" asp-action="Detalle" asp-route-id="@Model.Id" class="card-imagen" aria-label="@Model.Titulo">
        @if (Model.ImagenPortada != null)
        {
            <img src="@Model.ImagenPortada" alt="@Model.Titulo" loading="lazy" />
        }
        else
        {
            <div class="sin-imagen">@Model.CategoriaIcono</div>
        }
        <span class="card-categoria">@Model.CategoriaIcono @Model.Categoria</span>
    </a>

    <div class="card-cuerpo">
        <p class="card-fecha">📅 @Formato.Fecha(Model.Fecha, "ddd dd MMM yyyy · HH:mm")</p>
        <h3 class="card-titulo">@Model.Titulo</h3>
        <p class="card-lugar">📍 @Model.Ubicacion</p>

        <div class="card-pie">
            <span class="card-precio">@Formato.PrecioDesde(Model.PrecioDesde)</span>
            <a asp-controller="Eventos" asp-action="Detalle" asp-route-id="@Model.Id" class="btn-rosa">Ver más →</a>
        </div>
    </div>
</article>
