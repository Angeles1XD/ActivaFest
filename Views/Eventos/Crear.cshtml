@model ActivaFest.Models.Evento

<h2>Crear Evento</h2>

<form method="post">

    <input asp-for="Titulo" class="form-control mb-2" placeholder="Título" />

    <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-control mb-2">
        <option value="">Seleccione categoría</option>
    </select>

    <input asp-for="Ubicacion" class="form-control mb-2" placeholder="Ubicación" />

    <input asp-for="Fecha" type="datetime-local" class="form-control mb-2" />

    <input asp-for="Precio" type="number" class="form-control mb-2" />

    <input asp-for="CuposDisponibles" type="number" class="form-control mb-2" />

    <button class="btn btn-primary">Guardar</button>

</form>