@model ActivaFest.Models.Evento

<h2>Crear Evento</h2>

<form asp-action="Create" method="post">

    <div>
        <label>Título</label>
        <input asp-for="Titulo" class="form-control" />
    </div>

    <div>
        <label>Descripción</label>
        <input asp-for="Descripcion" class="form-control" />
    </div>

    <div>
        <label>Fecha</label>
        <input asp-for="Fecha" type="datetime-local" class="form-control" />
    </div>

    <div>
        <label>Precio</label>
        <input asp-for="Precio" class="form-control" />
    </div>

    <div>
        <label>Ubicación</label>
        <input asp-for="Ubicacion" class="form-control" />
    </div>

    <div>
        <label>Cupos</label>
        <input asp-for="CuposDisponibles" class="form-control" />
    </div>

    <div>
        <label>Categoría</label>
        <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-control"></select>
    </div>

    <br />

    <button type="submit">Guardar</button>
</form>

<a href="/Eventos">Volver</a>